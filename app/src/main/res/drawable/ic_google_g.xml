        android:fillColor="#34A853"
        android:pathData="M12,24c3.24,0 5.95,-1.08 7.93,-2.91l-3.86,-2.77c-1.08,0.72 -2.45,1.16 -4.07,1.16 -3.13,0 -5.78,-2.11 -6.73,-4.96H1.28v3.04C3.25,21.29 7.3,24 12,24z" />

    <!-- Left arc -->
