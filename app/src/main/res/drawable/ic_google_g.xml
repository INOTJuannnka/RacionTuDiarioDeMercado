<?xml version="1.0" encoding="utf-8"?>
<!--
    Google "G" mark, four-path brand colourway on a 24x24 viewport.

    The four arcs keep Google's fixed colour assignment: blue on the top-right, red on the
    top-left, yellow down the left, green along the bottom-right. That assignment is part of the
    mark, not a styling choice, so none of these four colours may be swapped for a theme role.

    This is the widely used vector form of the mark. If the app ever needs pixel-exact brand
    compliance, the asset Google publishes at
    https://developers.google.com/identity/gsi/web/button-guidelines is the authority and
    replaces this file; nothing in the code depends on the path data, only on this resource name.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Top-right arc -->
    <path
        android:fillColor="#4285F4"
        android:pathData="M23.49,12.27c0,-0.79 -0.07,-1.54 -0.19,-2.27H12v4.51h6.47c-0.28,1.49 -1.12,2.75 -2.38,3.59v2.77h3.86c2.26,-2.08 3.54,-5.15 3.54,-8.6z" />

    <!-- Bottom-right arc -->
