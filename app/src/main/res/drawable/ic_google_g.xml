        android:fillColor="#FBBC05"
        android:pathData="M5.27,14.52c-0.24,-0.72 -0.38,-1.49 -0.38,-2.28s0.14,-1.56 0.38,-2.28V7.92H1.28C0.56,9.63 0,11.71 0,14.24s0.56,4.61 1.28,6.32l3.99,-3.04z" />

