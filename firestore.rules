rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function: request must be from the document's owner
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // User profile: users/{uid}/profile/main
    match /users/{uid}/profile/{profileId} {
      allow read, write: if isOwner(uid);
    }

    // User goals: users/{uid}/goals/main
    match /users/{uid}/goals/{goalId} {
      allow read, write: if isOwner(uid);
    }

    // Day documents and entries subcollection: users/{uid}/days/{dayKey}
    match /users/{uid}/days/{dayKey} {
      allow read, write: if isOwner(uid);

      // Entries subcollection: users/{uid}/days/{dayKey}/entries/{entryId}
      match /entries/{entryId} {
        allow read, write: if isOwner(uid);
      }
    }

    // Onboarding consent: users/{uid}/onboarding/completed
    match /users/{uid}/onboarding/{doc} {
      allow read, write: if isOwner(uid);
    }

    // Catch-all: deny any other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}